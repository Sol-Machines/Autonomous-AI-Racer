# =============================================================================
# Track Mode — environment configuration
# =============================================================================

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3000

# Raspberry Pi go2rtc camera source
PI_IP=172.20.10.2
GO2RTC_PORT=1984

# Test mode: use local laptop webcam instead of Pi camera
USE_LAPTOP_CAMERA=0
LAPTOP_CAMERA_INDEX=0
LAPTOP_CAMERA_WIDTH=1280
LAPTOP_CAMERA_HEIGHT=720
LAPTOP_CAMERA_FPS=20
LAPTOP_CAMERA_JPEG_QUALITY=80

# ── Visual Odometry ─────────────────────────────────────────────────────────
# Camera height above floor in cm (measure from lens to ground)
CAMERA_HEIGHT_CM=9.0
# Camera tilt from horizontal in degrees (0 = looking straight ahead)
CAMERA_TILT_DEG=15.0
# Target FPS for VO processing
VO_TARGET_FPS=20

# ── Copilot ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3000
ZAPBOX_PORT=8080
INACTIVITY_SEC=3.0
