# Environment files
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
__pycache__/
*.pyc

# Node
node_modules/
.next/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Trained models (regenerated from training pipeline)
*.pt

# ── Solana keypairs and mint state — contain secrets, NEVER commit ─────────
# (path-flexible so they're protected wherever they live)
**/treasury-keypair.json
**/faucet-keypair.json
**/boost-mint.json

# ── Training data and exports (large, regenerable) ─────────────────────────
**/training/data/
**/training/exports/

# ── SQLite databases (local state) ─────────────────────────────────────────
**/data/*.sqlite
**/*.sqlite
**/*.sqlite-journal

# ── Legacy Race Mode rules (kept for safety; the path-flexible rules above
# already cover these, but keeping explicit paths in case folders linger) ──
Race Mode/training/exports/
Race Mode/training/data/
Race Mode/solana/treasury-keypair.json
Race Mode/solana/faucet-keypair.json
Race Mode/solana/boost-mint.json
