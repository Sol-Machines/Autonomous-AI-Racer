# =============================================================================
# Race Mode — environment configuration
# =============================================================================

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3000

# Raspberry Pi go2rtc camera source
PI_IP=172.20.10.2
GO2RTC_PORT=1984
# RTSP is used for the perception loop (laptop opens one persistent
# TCP capture and decodes locally — far cheaper than per-frame HTTP).
RTSP_PORT=8554
RTSP_PATH=camera
RTSP_TRANSPORT=tcp
# Override the full URL if your stream lives elsewhere.
# RTSP_URL=rtsp://172.20.10.2:8554/camera
# Refuse to drive on frames older than this many seconds.
FRAME_STALE_SEC=1.0

# Test mode: use local laptop webcam instead of Pi camera
USE_LAPTOP_CAMERA=0
LAPTOP_CAMERA_INDEX=0

# ── Perception ───────────────────────────────────────────────────────────────
# opencv | cnn
PERCEPTION_BACKEND=opencv
# Polling rate for perception (Hz). Snapshot endpoint can sustain ~5-10 Hz.
PERCEPTION_HZ=10
# Camera rotation if mounted upside-down or sideways. 0|90|180|270
CAMERA_ROTATE_DEG=180
# OpenCV line-follower tuning
OPENCV_THRESHOLD=80          # 0-255; pixels darker than this count as tape
OPENCV_ROI_TOP=0.55          # use the bottom 45% of the frame for steering
OPENCV_DEADBAND=0.12         # |centroid offset| below this = drive straight

# CNN backend weights (only used when PERCEPTION_BACKEND=cnn)
# Defaults to <repo>/training/exports/line_follower.pt — uncomment to override.
# CNN_WEIGHTS_PATH=./training/exports/line_follower.pt

# ── Frontend feature flags ───────────────────────────────────────────────────
# Set to "false" on the deployed demo to lock betting/voting until a real
# race is scheduled. Defaults to enabled for local development. The flag is
# read by Next.js at build time (it must be prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_BETTING_ENABLED=true

# ── Backend CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins permitted to call the Express
# backend. Required in production (NODE_ENV=production) — Next.js rewrites
# forward the browser's Origin header, so the deployed domain must be listed
# here or POSTs from the UI will fail with 500 / "CORS blocked origin".
# Default if unset: "http://localhost:5500,http://127.0.0.1:5500".
FRONTEND_ORIGINS=https://solmachines.wiktor.uk,http://localhost:3002,http://localhost:5500,http://127.0.0.1:5500

# ── Boost ────────────────────────────────────────────────────────────────────
BOOST_DURATION_SEC=3.0

# ── Solana ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
# Run `cd solana && npm install && npm run mint` to generate these values.
SOLANA_TREASURY_PUBKEY=
# SOLANA_TREASURY_ATA auto-resolved if blank (needs TREASURY_PUBKEY + BOOST_TOKEN_MINT).
SOLANA_TREASURY_ATA=
BOOST_TOKEN_MINT=
# Decimals must match what mint.ts created (default 0 = whole tokens only).
BOOST_TOKEN_DECIMALS=0
