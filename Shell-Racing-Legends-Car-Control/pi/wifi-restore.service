[Unit]
Description=Restore WiFi on boot
Before=network-online.target
After=sysinit.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "rfkill unblock wifi && ip link set wlan0 up && wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf && dhcpcd wlan0"

[Install]
WantedBy=multi-user.target
