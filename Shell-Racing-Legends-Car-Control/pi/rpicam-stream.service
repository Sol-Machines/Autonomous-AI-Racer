[Unit]
Description=rpicam-vid H.264 TCP stream
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/rpicam-vid --width 480 --height 360 --framerate 60 --codec h264 --profile baseline --inline --intra 30 --nopreview -t 0 --listen -o tcp://0.0.0.0:8555
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
